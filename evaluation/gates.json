    "minRecallAt1": 0.55,
    "minRecallAt3": 0.85,
    "minRecallAt5": 0.95,
    "minMrrAt5": 0.72,
    "minRequiredCoverage": 0.9
  },
  "answer": {
    "minPassRate": 0.9,
    "minCompletionRate": 1.0,
    "maxP95TotalMs": 45000,
