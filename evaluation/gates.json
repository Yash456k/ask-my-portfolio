    "globalForbiddenClaims": [
      {
        "label": "AIVID internship presented as ongoing",
        "pattern": "intern(?:ship)?\\b[^.]{0,60}AIVID[^.]{0,60}\\b(?:present|ongoing|currently)\\b|AIVID[^.]{0,60}\\bintern(?:ship)?\\b[^.]{0,40}\\b(?:present|ongoing|currently)\\b"
      },
      {
        "label": "Future AI Power mentioned (removed from the portfolio)",
        "pattern": "Future AI Power"
      },
      {
        "label": "degree presented as still in progress",
        "pattern": "\\b(?:is|he's)\\s+(?:currently\\s+|still\\s+)*(?:pursuing|studying)\\b"
      }
    ]
  }
}
