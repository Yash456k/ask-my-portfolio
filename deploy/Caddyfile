{
	email {$ACME_EMAIL}
	admin off
	servers {
		timeouts {
			read_header 5s
			read_body 15s
			write 120s
			idle 30s
		}
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 32KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Activity may change without a frontend deployment. Keep ETags, but
	# require validation before a browser reuses a saved response.
	header /v1/activity >Cache-Control "public, no-cache, must-revalidate" {
		match status 200 304
	}

	# Fail closed if new operator/admin routes are added to the application.
	@public {
		method GET HEAD POST OPTIONS
		path /v1/health /v1/config /v1/activity /v1/chat
	}
	handle @public {
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
				max_conns_per_host 16
			}
			header_up X-Real-IP {remote_host}
			header_up -X-Verify-Evaluation
			header_up -X-Verify-Fallback
		}
	}
	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}
