{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 32KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Activity may change without a frontend deployment. Keep ETags, but
	# require validation before a browser reuses a saved response.
	header /v1/activity >Cache-Control "public, no-cache, must-revalidate" {
		match status 200 304
	}

	reverse_proxy api:8000 {
		transport http {
			response_header_timeout 60s
		}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format json
	}
}
