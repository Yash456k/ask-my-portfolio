# Copy to .env only on the VPS. Never commit the real file.
GROQ_API_KEY=replace-on-server
# Optional until an OpenRouter model is selected. Keep this server-side only.
# OPENROUTER_API_KEY=sk-or-v1-replace-on-server
# Optional: enables the Jev retrieval route (TypeSafe). Keep this server-side only.
# TYPESAFE_API_KEY=replace-me
POSTGRES_DB=rag_playground
POSTGRES_USER=rag_playground
POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql://rag_playground:replace-with-url-encoded-password@db:5432/rag_playground
FRONTEND_ORIGINS=https://yash456k.com,https://www.yash456k.com,https://rag-playground-alpha.vercel.app
# Optional anchored pattern for this project's ephemeral Vercel preview URLs.
FRONTEND_ORIGIN_REGEX=^https://rag-playground-[a-z0-9-]+-your-vercel-team\.vercel\.app$
PUBLIC_API_URL=https://178-104-56-243.sslip.io
API_DOMAIN=178-104-56-243.sslip.io
PUBLIC_IPV4=178.104.56.243
ACME_EMAIL=replace-with-acme-contact-email
ALLOWED_HOSTS=178-104-56-243.sslip.io,localhost,127.0.0.1
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12
IP_HASH_SALT=generate-a-long-random-value
VERIFY_FALLBACK_TOKEN=generate-a-long-random-value
PER_IP_DAILY_LIMIT=15
GLOBAL_DAILY_LIMIT=120
# Hard application-side ceiling. 1,800,000 micro-USD = $1.80/month.
GLOBAL_MONTHLY_BUDGET_MICRO_USD=1800000
# Per-request input tokens reserved against the monthly budget; real requests use about 3k.
BUDGET_INPUT_TOKEN_RESERVE=8000
LOG_LEVEL=INFO
# Host directory containing the public-only activity cache mounted read-only by the API.
ACTIVITY_DATA_DIR=./var/activity
